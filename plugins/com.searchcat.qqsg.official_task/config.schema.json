{
  "type": "object",
  "properties": {
    "terrain_test_enabled": {
      "type": "boolean",
      "title": "仅执行地图调试中载入的实验路线",
      "default": false
    },
    "terrain_test_plan": {
      "type": "object",
      "title": "地图调试生成的实验路线",
      "default": {}
    },
    "calibrated": {
      "type": "boolean",
      "title": "坐标已经校准",
      "default": false
    },
    "input_mode": {
      "type": "string",
      "title": "输入方式",
      "enum": ["foreground", "background"],
      "default": "foreground"
    },
    "capture_mode": {
      "type": "string",
      "title": "截图方式",
      "enum": ["auto", "background", "foreground"],
      "default": "auto"
    },
    "task_region": {
      "type": "array",
      "title": "右侧任务栏 OCR 区域 [x,y,w,h]",
      "default": [520, 70, 270, 430]
    },
    "ocr_confidence": {
      "type": "number",
      "title": "任务栏 OCR 最低置信度",
      "minimum": 0.1,
      "maximum": 1,
      "default": 0.55
    },
    "task_keyword": {
      "type": "string",
      "title": "用于确认官爵任务存在的关键词",
      "default": "官爵"
    },
    "prefer_task_click_navigation": {
      "type": "boolean",
