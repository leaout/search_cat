{
  "id": "com.searchcat.qqsg.official-task",
  "name": "QQ三国官爵任务",
  "version": "0.3.0",
  "sdk_version": "1",
  "entry": "main.py",
  "description": "统一执行官爵、举孝廉和运送物资任务，支持自动寻路、答题和任务完成判断。",
  "permissions": [
    "window.bind",
    "screen.capture",
    "mouse.foreground",
    "mouse.background",
    "keyboard.foreground",
    "keyboard.background",
    "filesystem.plugin_data"
  ],
  "config_schema": "config.schema.json",
  "templates": [
    {"id": "dialog_task", "name": "对话/任务选项", "path": "images/dialog_task.png"},
    {"id": "task_entry", "name": "官爵任务条目", "path": "images/task_entry.png"},
    {"id": "accept_confirm", "name": "请交给我吧", "path": "images/accept_confirm.png"}
  ]
}
